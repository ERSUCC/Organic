name = "Inline lone fillable value"

---

oscillator(frequency: 440, waveform: |phase|)

---

name = "Inline fillable value in expression"

---

oscillator(frequency: 440, waveform: 1 + |phase| - 42)

---

name = "Fillable value in nested built-in function call"

---

oscillator(frequency: 440, waveform: repeat(value: |phase|))

---

name = "Fillable value in nested user function call"

---

get-wave(phase: number) = {
    phase / pi - 1
}

oscillator(frequency: 440, waveform: get-wave(phase: |phase|))

---

name = "Fillable value in nested function call with expression"

---

get-wave(phase: number) = {
    phase
}

oscillator(frequency: 440, waveform: get-wave(phase: |phase| / pi - 1))

---

name = "Multiple fillable values"

---

map(values: [ c1, c2, c3 ], template: oscillator(frequency: |value|, waveform: |phase|))

---

name = "Multiple fillable values in same context"

---

map(values: [ -1, 0, 1 ], template: oscillator(frequency: a4, waveform: |phase| + |value|))
