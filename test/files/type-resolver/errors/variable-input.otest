name = "Invalid variable type in function input"
line = 4
character = 17
error = 'Expected a number for input "frequency", but received a sequence order constant.'

---

test = forward

sine(frequency: test)

---

name = "Invalid variable type from outer scope in function input"
line = 5
character = 21
error = 'Expected a number for input "frequency", but received a string.'

---

test = "test"

func() = {
    sine(frequency: test)
}

---

name = "Invalid input type in function input"
line = 3
character = 21
error = 'Expected a number for input "frequency", but received a list of numbers.'

---

func(test: [ 1, 2, 3 ]) = {
    sine(frequency: test)
}
