name = "Chained boolean expressions"
line = 2
character = 8
error = "Expected a number on the left-hand side, but received a boolean."

---

test = 1 == 2 == 3

---

name = "Chained parenthesized boolean expressions"
line = 2
character = 8
error = "Expected a number on the left-hand side, but received a boolean."

---

test = (1 == 2) == 3

---

name = "Add boolean expression to number"
line = 2
character = 12
error = "Expected a number on the right-hand side, but received a boolean."

---

test = 1 + (2 == 3)

