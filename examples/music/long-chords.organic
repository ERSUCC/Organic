note-length = 32000

swell = repeat(value: lfo(from: 0, to: 1, length: note-length))

sine(frequency: repeat(value: sequence(values: [
    hold(value: af2, length: note-length),
    hold(value: g2, length: note-length),
    hold(value: c3, length: note-length),
    hold(value: b2, length: note-length),
    hold(value: c3, length: note-length),
    hold(value: c3, length: note-length),
    hold(value: g2, length: note-length)
])), volume: swell * 0.75)

sine(frequency: repeat(value: sequence(values: [
    hold(value: c4, length: note-length),
    hold(value: c4, length: note-length),
    hold(value: d4, length: note-length),
    hold(value: d4, length: note-length),
    hold(value: f4, length: note-length),
    hold(value: ef4, length: note-length),
    hold(value: d4, length: note-length)
])), volume: swell)

sine(frequency: repeat(value: sequence(values: [
    hold(value: ef4, length: note-length),
    hold(value: ef4, length: note-length),
    hold(value: f4, length: note-length),
    hold(value: g4, length: note-length),
    hold(value: af4, length: note-length),
    hold(value: g4, length: note-length),
    hold(value: f4, length: note-length)
])), volume: swell)

sine(frequency: repeat(value: sequence(values: [
    hold(value: g4, length: note-length),
    hold(value: g4, length: note-length),
    hold(value: c5, length: note-length),
    hold(value: c5, length: note-length),
    hold(value: c5, length: note-length),
    hold(value: c5, length: note-length),
    hold(value: b4, length: note-length)
])), volume: swell * 0.5)
