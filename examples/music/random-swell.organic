swell-attack = 2000
swell-decay = 500
swell-length = swell-attack + swell-decay

swell(period: 0, frequency: 0) = {
    offset = random(from: period, to: period * 2, length: period * 2)
    gap = random(from: period - swell-length, to: period * 2 - swell-length, length: period * 2)

    volume = sequence(values: [
        hold(value: 0, length: if(condition: period > swell-length, is-true: offset, is-false: 0)),
        repeat(value: sequence(values: [
            sweep(from: 0, to: 1, length: swell-attack),
            sweep(from: 1, to: 0, length: swell-decay),
            hold(value: 0, length: gap)
        ]))
    ])

    saw(volume: volume, frequency: frequency)
}

group(volume: 4, sources: [
    swell(period: swell-length, frequency: f3),
    swell(period: swell-length * 2, frequency: f2),
    swell(period: swell-length * 4, frequency: c3),
    swell(period: swell-length * 4, frequency: c4),
    swell(period: swell-length * 8, frequency: a4),
    swell(period: swell-length * 8, frequency: bf4)
], effects: [
    low-pass(threshold: 500),
    reverb(mix: 0.75, length: 10000),
    low-pass(threshold: 1000)
])
