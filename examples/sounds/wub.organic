squeeze(phase: 0) = {
    top = repeat(value: random(from: 2, to: 6, length: 200, type: linear))
    mult = repeat(value: lfo(from: 1, to: top, length: 800 / top))

    if(condition: modulo(value: phase, divisor: tau / mult) * mult / pi < 1, is-true: 1, is-false: -1)
}

oscillator(volume: 0.25, frequency: c3, waveform: squeeze(phase: |phase|))
