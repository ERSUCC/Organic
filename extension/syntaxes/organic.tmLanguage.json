{
  "$schema": "https://github.com/martinring/tmlanguage/raw/refs/heads/master/tmlanguage.json",
	"name": "Organic",
	"scopeName": "source.organic",
	"patterns": [{
    "include": "#comment"
  }, {
    "include": "#function"
  }, {
    "include": "#string"
  }, {
    "include": "#constant"
  }, {
    "include": "#language-constant"
  }, {
    "include": "#type-name"
  }, {
    "include": "#variable"
  }, {
    "include": "#operator"
  }],
	"repository": {
		"comment": {
			"patterns": [{
        "name": "comment.line.organic",
        "match": "//.*\n"
      }, {
        "name": "comment.block.organic",
        "begin": "/\\*",
        "end": "\\*/"
      }]
		},
		"function": {
			"patterns": [{
        "match": "([a-zA-Z_][a-zA-Z0-9\\-_]*)\\s*\\(",
        "captures": {
          "1": {
            "name": "entity.name.function.organic"
          }
        }
      }]
		},
		"string": {
			"patterns": [{
        "name": "string.quoted.double.organic",
        "begin": "\"",
        "end": "\""
      }]
		},
		"constant": {
			"patterns": [{
        "name": "constant.numeric.organic",
        "match": "-?([0-9]+[.])?[0-9]+"
      }]
		},
		"language-constant": {
			"patterns": [{
        "name": "constant.language.organic",
        "match": "\\b(forward|backward|shuffle|stay|linear|nearest|up|down|[a-g][sf]?[0-9]|pi|tau|e|true|false)\\b"
      }]
		},
    "type-name": {
      "patterns": [{
        "name": "storage.type.organic",
        "match": "\\b(anything|sequence-order|random-type|round-direction|number|boolean|string|audio-source|effect)\\b"
      }]
    },
		"variable": {
			"patterns": [{
        "name": "variable.parameter.organic",
        "match": "\\|[a-zA-Z_][a-zA-Z0-9\\-_]*\\|"
      }, {
        "name": "variable.name.organic",
        "match": "[a-zA-Z_][a-zA-Z0-9\\-_]*"
      }]
		},
    "operator": {
      "patterns": [{
        "name": "keyword.operator.organic",
        "match": "[+\\-*/^<>=]|==|<=|>="
      }]
    }
	}
}
