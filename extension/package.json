{
  "name": "organic",
  "displayName": "Organic",
  "description": "Syntax highlighting for Organic",
  "version": "0.2.0",
  "publisher": "ERSUCC",
  "engines": {
    "vscode": "^1.85.0",
    "node": "~24.15.0"
  },
  "license": "See LICENSE.txt",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "organic",
    "music",
    "sound",
    "audio"
  ],
  "contributes": {
    "languages": [{
      "id": "organic",
      "aliases": [
        "Organic",
        "organic"
      ],
      "extensions": [
        ".organic"
      ],
      "configuration": "./configs/organic-configuration.json",
      "icon": {
        "light": "./icons/icon-padded.png",
        "dark": "./icons/icon-padded.png"
      }
    }, {
      "id": "otest",
      "aliases": [
        "Organic Test",
        "OTest",
        "otest"
      ],
      "extensions": [
        ".otest"
      ],
      "configuration": "./configs/otest-configuration.json",
      "icon": {
        "light": "./icons/test-icon-padded.png",
        "dark": "./icons/test-icon-padded.png"
      }
    }],
    "grammars": [{
      "language": "organic",
      "scopeName": "source.organic",
      "path": "./syntaxes/organic.tmLanguage.json"
    }, {
      "language": "otest",
      "scopeName": "source.otest",
      "path": "./syntaxes/otest.tmLanguage.json",
      "embeddedLanguages": {
        "meta.embedded.section.organic": "organic"
      }
    }],
    "commands": [{
      "command": "organic.run",
      "title": "Run Program",
      "icon": "$(debug-start)"
    }, {
      "command": "organic.stop",
      "title": "Stop Program",
      "icon": "$(debug-stop)"
    }],
    "menus": {
      "editor/title": [{
        "command": "organic.run",
        "group": "navigation",
        "when": "editorLangId == organic"
      }, {
        "command": "organic.stop",
        "group": "navigation",
        "when": "editorLangId == organic"
      }]
    }
  },
  "repository": {
  	"type": "git",
  	"url": "https://github.com/ERSUCC/Organic"
  },
  "icon": "./icons/icon-full.png",
  "main": "./out/src/extension.js",
  "scripts": {
    "vscode:prepublish": "tsc"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "@types/vscode": "~1.85.0",
    "@types/node": "~26.6.5"
  },
  "allowScripts": {
    "node@24.15.0": true
  }
}
